{
  "version": 2,
  "builds": [
    {
      "src": "zns-oms/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "zns-oms/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}