{
  "version": 2,
  "builds": [
    {
      "src": "quanlybanhang/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["quanlybanhang/public/**", "quanlybanhang/data/**"]
      }
    },
    {
      "src": "quanlybanhang/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "quanlybanhang/server.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "quanlybanhang/server.js"
    }
  ]
}
